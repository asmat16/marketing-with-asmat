{
  "name": "Marketing with ASMAT",
  "website": "https://www.marketingwithasmat.pro",
  "typography": {
    "primary": {
      "family": "Inter",
      "source": "Google Fonts",
      "fallback": "system-ui, -apple-system, sans-serif",
      "weights": [400, 500, 600, 700]
    },
    "logo": {
      "marketing": { "weight": 600, "sizeRatio": 0.54, "color": "#a1a1aa" },
      "with": { "weight": 400, "sizeRatio": 0.54, "color": "#71717a" },
      "asmat": { "weight": 700, "sizeRatio": 1, "letterSpacing": "0.12em", "color": "#fafafa", "accentColor": "#2dd4bf" }
    }
  },
  "colors": {
    "background": { "hex": "#14141f", "rgb": "20, 20, 31", "usage": "Page background, dark posts" },
    "surface": { "hex": "#1c1c2a", "rgb": "28, 28, 42", "usage": "Sections, alternate blocks" },
    "card": { "hex": "#232334", "rgb": "35, 35, 52", "usage": "Cards, elevated panels" },
    "cardHover": { "hex": "#2a2a3d", "rgb": "42, 42, 61", "usage": "Hover states" },
    "foreground": { "hex": "#f4f4f5", "rgb": "244, 244, 245", "usage": "Primary text" },
    "muted": { "hex": "#9ca3af", "rgb": "156, 163, 175", "usage": "Secondary text" },
    "accent": { "hex": "#2dd4bf", "rgb": "45, 212, 191", "usage": "CTAs, highlights, logo accent" },
    "accentSecondary": { "hex": "#818cf8", "rgb": "129, 140, 248", "usage": "Secondary highlights" },
    "border": { "hex": "rgba(255,255,255,0.1)", "usage": "Dividers, frames" },
    "ctaText": { "hex": "#09090b", "rgb": "9, 9, 11", "usage": "Text on teal buttons" }
  },
  "patterns": {
    "grid": {
      "description": "48px subtle grid on dark backgrounds",
      "lineColor": "rgba(255, 255, 255, 0.03)",
      "size": "48px"
    },
    "gradientText": {
      "description": "Optional headline accent only — not for logo",
      "stops": ["#f4f4f5", "#2dd4bf", "#818cf8"]
    }
  },
  "spacing": {
    "logoGapHorizontal": "0.65em",
    "logoPaddingSquare": "48px"
  },
  "social": {
    "square": { "width": 1080, "height": 1080 },
    "story": { "width": 1080, "height": 1920 },
    "linkedin": { "width": 1200, "height": 627 },
    "og": { "width": 1200, "height": 630 }
  }
}
